  "checkerSource": "import { readFileSync, writeFileSync, mkdirSync } from 'node:fs';\nimport { spawnSync } from 'node:child_process';\nconst preparation = JSON.parse(readFileSync(process.argv[2], 'utf8'));\nconst outputRoot = process.argv[3];\nmkdirSync(outputRoot, { recursive: true, mode: 0o700 });\nconst checks = [];\nfor (const binding of preparation.engine) {\n  const env = Object.fromEntries(Object.entries(process.env).filter(([name]) => !/KEY|TOKEN|PASSWORD|SECRET|CREDENTIAL/.test(name.toUpperCase())));\n  const child = spawnSync('/home/genie/.hermes/node/bin/node', ['/home/genie/orca/workspaces/genie/mikro-engine-split/scripts/mikro/engine-experiment-runtime.mjs', '--profile', binding.profilePath, '--check'], { env, encoding: 'utf8', timeout: 120000, maxBuffer: 10000000 });\n  if (child.status !== 0) throw new Error(`Actual noninference profile check ${binding.id} failed: ${child.error?.message ?? child.stderr}`);\n  const description = JSON.parse(child.stdout);\n  if (description.profileSha256 !== binding.profileSha256) throw new Error(`Actual profile byte identity differs: ${binding.id}`);\n  const receipt = { id: binding.id, actualExitCode: child.status, profileSha256: description.profileSha256, effectiveConfigSha256: description.effectiveConfigSha256,\n    budgetBinding: description.budgetBinding, model: `${description.provider}/${description.model}`, sdkNominalRates: description.sdkNominalRates,\n    api: description.api, engine: description.engine, modelCalls: 0, actualCompletedAt: new Date().toISOString() };\n  writeFileSync(`${outputRoot}/${binding.id}.json`, JSON.stringify(receipt, null, 2) + '\\n', { flag: 'wx', mode: 0o600 });\n  checks.push(receipt);\n  console.log(JSON.stringify({ id: binding.id, actualExitCode: child.status, exactDepthZero: description.budgetBinding.maxDepth === 0, modelCalls: 0 }));\n}\nwriteFileSync(`${outputRoot}/complete.json`, JSON.stringify({ scope: 'actual Node26 public profile checks, no backend/model dispatch', checks }, null, 2) + '\\n', { flag: 'wx', mode: 0o600 });\n",
