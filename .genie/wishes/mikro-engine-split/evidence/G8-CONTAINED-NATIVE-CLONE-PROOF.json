  "source": "import { appendFileSync, existsSync, mkdirSync, readFileSync, realpathSync, writeFileSync } from 'node:fs';\nimport { dirname, join } from 'node:path';\nimport { spawnSync } from 'node:child_process';\nconst plan = JSON.parse(readFileSync(process.argv[2], 'utf8'));\nconst gitEnv = { PATH: '/usr/bin:/bin', HOME: process.env.HOME, GH_CONFIG_DIR: '/home/genie/.config/gh', LANG: 'C.UTF-8', GIT_TERMINAL_PROMPT: '0' };\nconst git = (dir, args) => {\n  const result = spawnSync('/usr/bin/git', ['-C', dir, ...args], { env: gitEnv, encoding: 'utf8' });\n  if (result.status !== 0) throw new Error(`Git ${args[0]} failed: ${result.status}: ${result.stderr}`);\n  return result.stdout.trim();\n};\nconst rows = [];\nfor (const cell of plan.cells) {\n  if (existsSync(cell.destination)) throw new Error(`Fresh clone exists: ${cell.id}`);\n  if (git(cell.source, ['rev-parse', 'HEAD']) !== cell.parentCommit) throw new Error(`Frozen seed HEAD mismatch: ${cell.id}`);\n  mkdirSync(dirname(cell.destination), { recursive: true, mode: 0o700 });\n  const cloned = spawnSync('/usr/bin/git', ['clone', '--no-local', '--no-hardlinks', '--no-checkout', cell.source, cell.destination], { env: gitEnv, encoding: 'utf8' });\n  if (cloned.status !== 0) throw new Error(`Clone ${cell.id} failed: ${cloned.stderr}`);\n  git(cell.destination, ['remote', 'set-url', 'origin', cell.origin]);\n  git(cell.destination, ['config', '--local', 'credential.helper', '!gh auth git-credential']);\n  git(cell.destination, ['fetch', 'origin', 'dev:refs/remotes/origin/dev']);\n  if (git(cell.destination, ['rev-parse', 'refs/remotes/origin/dev']) !== cell.parentCommit) throw new Error(`Actual authorized remote dev mismatch: ${cell.id}`);\n  git(cell.destination, ['switch', '--create', 'dev', cell.parentCommit]);\n  const commonDir = realpathSync(git(cell.destination, ['rev-parse', '--path-format=absolute', '--git-common-dir']));\n  appendFileSync(join(commonDir, 'info', 'exclude'), '\\n/.g8-runtime/\\n');\n  const head = git(cell.destination, ['rev-parse', 'HEAD']);\n  const tree = git(cell.destination, ['rev-parse', 'HEAD^{tree}']);\n  const shallow = git(cell.destination, ['rev-parse', '--is-shallow-repository']);\n  const status = git(cell.destination, ['status', '--porcelain', '--untracked-files=all']);\n  if (head !== cell.parentCommit || shallow !== 'false' || status || existsSync(join(commonDir, 'objects', 'info', 'alternates'))) throw new Error(`Incomplete or changed isolated parent: ${cell.id}`);\n  const row = { id: cell.id, cwd: realpathSync(cell.destination), gitCommonDir: commonDir, head, tree, origin: git(cell.destination, ['remote', 'get-url', 'origin']), shallow: false, alternates: false, status, localGitExclusion: '/.g8-runtime/' };\n  rows.push(row);\n  console.log(JSON.stringify(row));\n}\nconst output = { schemaVersion: 1, ownerDecision: plan.ownerDecision, rows, actualGithubFetchCommands: rows.filter(row => row.origin.startsWith('https://github.com/')).length, modelCalls: 0, originalSourcesMovedOrChanged: false, priorInvocation: 'bg_49 failed before cloning because seed had no local dev branch; no source/model mutation' };\nwriteFileSync(join(dirname(process.argv[2]), 'native-contained-clone-proof.json'), `${JSON.stringify(output, null, 2)}\\n`, { flag: 'wx', mode: 0o600 });\n",
