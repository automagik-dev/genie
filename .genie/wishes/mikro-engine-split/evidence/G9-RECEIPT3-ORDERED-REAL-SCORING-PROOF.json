  "source": "import assert from 'node:assert/strict';\nimport { readFileSync, writeFileSync } from 'node:fs';\nimport { createHash } from 'node:crypto';\nimport { scoreAnswer } from '/home/genie/orca/workspaces/genie/mikro-engine-split/scripts/mikro/score.ts';\nconst input = JSON.parse(readFileSync(process.argv[2], 'utf8'));\nconst load = seal => {\n  const bytes = readFileSync(seal.path);\n  assert.equal(createHash('sha256').update(bytes).digest('hex'), seal.sha256);\n  return JSON.parse(bytes.toString('utf8'));\n};\nconst cohort = load(input.cohortSeal);\nconst registration = load(input.fixtureRegistrationSeal);\nconst exercises = [];\nfor (const pair of input.pairs) {\n  const rows = pair.map(load);\n  assert(rows[0].verified && !rows[1].verified);\n  for (const k of ['fixtureId','modelId','arm']) assert.equal(rows[0].cell[k], rows[1].cell[k]);\n  assert.equal(cohort.runs.findIndex(s => s.path === pair[1].path), cohort.runs.findIndex(s => s.path === pair[0].path)+1);\n  const fixture = registration.fixtures.find(f => f.id === rows[0].cell.fixtureId);\n  assert(fixture);\n  const truth = {files:fixture.truth.filter(t => !t.new).map(t => t.path),newFiles:fixture.truth.filter(t => t.new).map(t => t.path)};\n  const emitted = [];\n  for (const row of rows) {\n    const score = scoreAnswer('wish-context',row.verified?row.result.answer:undefined,truth,row.verified?(row.result.attempts.at(-1)?.citations??[]):[]);\n    assert.deepEqual(score,row.score);\n    emitted.push(score);\n  }\n  assert.equal(emitted[1].filesRecall,0);\n  if (truth.newFiles.length) assert.equal(emitted[1].newFilesRecall,0);\n  assert.equal(emitted[1].citationsTotal,0);\n  assert(rows[1].pathClassification.every(kind => kind.predicted.length===0));\n  exercises.push({cells:rows.map(row => row.cell),recordSeals:pair,scoreInOriginalSuccessfulThenFailedOrder:emitted,failedPredictions:rows[1].pathClassification});\n}\nassert(exercises.some(e => e.scoreInOriginalSuccessfulThenFailedOrder[0].filesRecall>0));\nconst proof = {schemaVersion:1,kind:'real-sealed-ordered-success-then-failure-scoring-proof-and-public-scorer-replay',candidateManifestSha256:input.candidateManifestSha256,cohortSeal:input.cohortSeal,fixtureRegistrationSeal:input.fixtureRegistrationSeal,sourceConsumer:'engine-experiment.ts runCell842-853 consumes verified?result.answer:undefined; exact existing public scoreAnswer replayed on original real captured inputs, not a new scored cohort',exercises,paidOrExternalCalls:0,sourceOrArtifactModified:false,limit:'Actual ordered runCell executions are demonstrated by sealed cohort records; replay executes unchanged public scorer using those actual saved values. No new model result, alternate scorer, grade mutation or resampling.'};\nwriteFileSync(process.argv[3],JSON.stringify(proof,null,2)+'\\n',{mode:0o600,flag:'wx'});\nconsole.log(JSON.stringify({proofPath:process.argv[3],realAdjacentPairs:exercises.length,successfulNonzeroRecallPairs:exercises.filter(e => e.scoreInOriginalSuccessfulThenFailedOrder[0].filesRecall>0).length,allFailedNoStaleScore:true,paidOrExternalCalls:0}));\n",
