{
  "name": "genie",
  "version": "5.260814.3",
  "description": "Human-AI partnership for Kimi Code CLI. Share a terminal, orchestrate workers, evolve together. Brainstorm ideas, turn them into wishes, execute with /genie:work, validate with /genie:review, and ship as one team.",
  "author": {
    "name": "Namastex Labs",
    "url": "https://github.com/automagik-dev"
  },
  "homepage": "https://github.com/automagik-dev/genie",
  "repository": "https://github.com/automagik-dev/genie",
  "license": "MIT",
  "keywords": ["workflow", "orchestration", "collaboration", "kimi-code", "agents"],
  "skills": "./skills/",
  "sessionStart": {
    "skill": "genie"
  },
  "commands": "./.kimi-plugin/commands/",
  "mcpServers": {
    "genie": {
      "command": "./scripts/mcp-launcher.cjs"
    }
  },
  "hooks": [
    {
      "event": "SessionStart",
      "matcher": "startup|resume",
      "command": "node \"$KIMI_PLUGIN_ROOT/scripts/session-context.cjs\"",
      "timeout": 5
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash|Read|Write|Edit|Agent|AgentSwarm",
      "command": "node \"$KIMI_PLUGIN_ROOT/scripts/dispatch-runtime.cjs\" claude --launcher-contract genie-claude-dispatch-v1 --launcher-sha256 48ea38c7d8e715b209553be825cb0b448e35402381c5b717d6466fe12943b214",
      "timeout": 125
    },
    {
      "event": "PreToolUse",
      "matcher": "Write|Edit",
      "command": "node \"$KIMI_PLUGIN_ROOT/scripts/validate-wish.cjs\"",
      "timeout": 5
    },
    {
      "event": "PostToolUse",
      "matcher": "Write|Edit",
      "command": "node \"$KIMI_PLUGIN_ROOT/scripts/validate-wish.cjs\"",
      "timeout": 5
    }
  ],
  "interface": {
    "displayName": "Genie",
    "shortDescription": "Plan, execute, review, and ship with Genie",
    "longDescription": "First-class Genie workflows for Kimi Code CLI, including shared skills, lifecycle hooks, and MCP task state. Role agents can be installed optionally by copying agents/*.md into ~/.kimi-code/agents/.",
    "developerName": "Namastex Labs",
    "websiteURL": "https://github.com/automagik-dev/genie"
  }
}
